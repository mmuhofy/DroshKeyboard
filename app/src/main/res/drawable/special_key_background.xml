<?xml version="1.0" encoding="utf-8"?>
<!--
    Background of the special keys row (Ctrl / Alt / Esc / Tab), styled like
    the FUTO Keyboard action bar items: key-container colored chips with a
    lighter pressed overlay. The armed state is applied from code with the
    accent fill.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#55808080" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#22808080" />
            <corners android:radius="9dp" />
        </shape>
    </item>
</selector>
