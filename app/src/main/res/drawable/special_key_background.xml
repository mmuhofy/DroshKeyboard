<?xml version="1.0" encoding="utf-8"?>
<!--
    Background of the special keys row (Ctrl / Alt / Esc / Tab): solid pill
    chips in the key container tone, like the FUTO action bar items. The
    pressed overlay is lighter; the armed state is applied from code with the
    accent fill.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#3B3E46" />
            <corners android:radius="50dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1E2024" />
            <corners android:radius="50dp" />
        </shape>
    </item>
</selector>
