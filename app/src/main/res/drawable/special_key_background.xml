<?xml version="1.0" encoding="utf-8"?>
<!--
    Background of the special keys row (Ctrl / Alt / Esc / Tab) in the
    quickbar. Subtle translucent chips so the keys read as tappable without
    competing with the key grid. The armed state is applied from code with a
    Drosh-accent fill.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#2EFFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#12FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
