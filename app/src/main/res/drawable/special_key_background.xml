<?xml version="1.0" encoding="utf-8"?>
<!--
    Background of a special keys chip. States (most specific first):
    - activated + pressed: armed sticky modifier while touched
    - pressed: lighter tone (touch feedback)
    - activated: armed sticky modifier (accent fill)
    - default: key container tone
    SPDX-License-Identifier: GPL-3.0-only
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true" android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#9AB4F0" />
            <corners android:radius="50dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#3B3E46" />
            <corners android:radius="50dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#B2C8FF" />
            <corners android:radius="50dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1E2024" />
            <corners android:radius="50dp" />
        </shape>
    </item>
</selector>
